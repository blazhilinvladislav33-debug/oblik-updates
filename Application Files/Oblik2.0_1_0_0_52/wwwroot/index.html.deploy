<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#020617">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href="/manifest.webmanifest">
<title>Облік · Сканер</title>
<style>
/* ═══════════════════════════════════════════════════════════════════
   Оформлення під телефон на складі, а не під офісний монітор.

   Кнопки великі, бо руки в рукавицях. Контраст високий, бо на складі
   світло або тьмяне, або б'є прямо в екран. Нічого не ховається за
   наведенням і довгим натисканням — тільки видимі кнопки.
   ═══════════════════════════════════════════════════════════════════ */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{
  background:#020617;color:#F8FAFC;
  font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  padding-bottom:env(safe-area-inset-bottom);
  overscroll-behavior-y:contain;
}
.hidden{display:none!important}

header{
  position:sticky;top:0;z-index:20;
  background:#0B1220;border-bottom:1px solid #1E293B;
  padding:calc(10px + env(safe-area-inset-top)) 14px 10px;
  display:flex;align-items:center;gap:10px;
}
header .back{
  background:none;border:none;color:#38BDF8;font-size:26px;
  padding:0 6px;line-height:1;cursor:pointer;
}
header h1{font-size:16px;margin:0;flex:1;font-weight:700}
header .who{font-size:10px;color:#64748B;text-align:right;line-height:1.3}

main{padding:14px;max-width:640px;margin:0 auto}

/* ── кнопки ── */
button{font-family:inherit}
.btn{
  display:block;width:100%;border:none;border-radius:12px;
  padding:16px;font-size:16px;font-weight:700;cursor:pointer;margin-bottom:10px;
}
.btn.primary{background:#22C55E;color:#020617}
.btn.blue{background:#0EA5E9;color:#020617}
.btn.ghost{background:#111C31;color:#94A3B8;border:1px solid #233047;font-weight:600}
.btn.danger{background:#1B0606;color:#F87171;border:1px solid #7F1D1D;font-weight:600}
.btn.scan{background:#38BDF8;color:#020617;font-size:19px;padding:22px}
.btn:disabled{opacity:.45}
.btn.small{padding:11px;font-size:13px;margin-bottom:0}

input,select,textarea{
  width:100%;padding:14px;border-radius:10px;font-size:16px;
  background:#0B1220;color:#F8FAFC;border:1px solid #334155;margin-bottom:10px;
  font-family:inherit;
}
label{display:block;font-size:11px;color:#64748B;font-weight:600;margin:0 0 5px 2px;letter-spacing:.04em}

.card{background:#0F172A;border:1px solid #233047;border-radius:12px;padding:14px;margin-bottom:10px}
.card h2{font-size:16px;margin:0 0 8px}
.muted{color:#64748B;font-size:12px}
.row{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid #16223A;font-size:14px}
.row:last-child{border-bottom:none}
.row .k{color:#64748B;flex-shrink:0}
.row .v{text-align:right;font-weight:600;word-break:break-word}

.pill{display:inline-block;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700}
.pill.ok{background:#04170D;color:#22C55E;border:1px solid #166534}
.pill.warn{background:#1B1206;color:#F59E0B;border:1px solid #78350F}
.pill.bad{background:#1B0606;color:#F87171;border:1px solid #7F1D1D}

.tile{
  display:block;width:100%;text-align:left;background:#0F172A;border:1px solid #233047;
  border-radius:12px;padding:14px;margin-bottom:10px;color:#F8FAFC;cursor:pointer;font-size:15px;
}
.tile b{display:block;font-size:15px;margin-bottom:3px}
.tile .sub{font-size:12px;color:#64748B}

.msg{padding:12px 14px;border-radius:10px;margin-bottom:12px;font-size:13px;font-weight:600}
.msg.err{background:#1B0606;color:#F87171;border:1px solid #7F1D1D}
.msg.ok{background:#04170D;color:#22C55E;border:1px solid #166534}

/* ── сканер ── */
#scanner{position:fixed;inset:0;z-index:100;background:#000;display:flex;flex-direction:column}
#scanner video{flex:1;width:100%;object-fit:cover}
#frame{
  position:absolute;left:12%;right:12%;top:26%;height:0;padding-bottom:52%;
  border:3px solid #38BDF8;border-radius:18px;pointer-events:none;
  box-shadow:0 0 0 100vmax rgba(2,6,23,.55);
}
#scanBar{
  position:absolute;left:0;right:0;bottom:0;padding:14px 14px calc(14px + env(safe-area-inset-bottom));
  background:linear-gradient(transparent,rgba(2,6,23,.94) 30%);
}
#scanInfo{color:#F8FAFC;font-size:14px;font-weight:700;text-align:center;margin-bottom:10px;min-height:20px}
#scanCount{color:#38BDF8;font-size:12px;text-align:center;margin-bottom:10px}

.stack{display:flex;gap:8px}
.stack>*{flex:1}
.qty{display:flex;gap:8px;align-items:center;margin-bottom:10px}
.qty input{margin:0;text-align:center;font-size:20px;font-weight:700}
.qty button{width:56px;height:52px;border-radius:10px;background:#1E293B;color:#38BDF8;
  border:1px solid #334155;font-size:24px;font-weight:700;flex-shrink:0}

.item{background:#0F172A;border:1px solid #233047;border-radius:10px;padding:11px 12px;margin-bottom:8px;
  display:flex;justify-content:space-between;align-items:center;gap:10px}
.item .n{font-size:14px;font-weight:600}
.item .s{font-size:11px;color:#38BDF8;font-family:ui-monospace,monospace}
.item .x{background:none;border:none;color:#64748B;font-size:22px;padding:4px 8px;flex-shrink:0}
</style>
</head>
<body>

<header id="hdr" class="hidden">
  <button class="back hidden" id="btnBack" onclick="goBack()">‹</button>
  <h1 id="title">Облік</h1>
  <div class="who" id="who"></div>
</header>

<main id="app"></main>

<!-- Сканер поверх усього -->
<div id="scanner" class="hidden">
  <video id="video" playsinline muted></video>
  <div id="frame"></div>
  <div id="scanBar">
    <div id="scanInfo"></div>
    <div id="scanCount"></div>
    <div class="stack">
      <button class="btn ghost small" onclick="stopScan()">Закрити</button>
      <button class="btn blue small" onclick="promptManual()">Ввести код</button>
    </div>
  </div>
</div>

<script src="/vendor/jsQR.js"></script>
<script>
/* ═══════════════════════════════════════════════════════════════════
   Клієнт сканера.

   Один файл і жодного фреймворку — свідомо. Сторінку відкривають з
   телефона на складі, часто через слабкий мобільний інтернет, і кожен
   зайвий кілобайт тут коштує секунд очікування перед першим скануванням.

   Токен зберігається в localStorage. Це компроміс: зберігати його —
   означає, що втрачений розблокований телефон дає доступ; не зберігати —
   означає вводити пароль на кожній коробці. Тому термін життя токена
   обмежений добою, а адміністратор може відкликати доступ будь-коли.
   ═══════════════════════════════════════════════════════════════════ */

const S = {
  token: localStorage.getItem('oblik_token') || '',
  user: null,
  view: 'home',
  stack: [],
  session: null,
  items: [],
  warehouses: [],
  scanTarget: null,
  scanned: 0
};

const $ = (id) => document.getElementById(id);
const esc = (t) => String(t ?? '').replace(/[&<>"']/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = (v) => (Math.round(v * 1000) / 1000).toString();

// ═══════════════════════ ЗВ'ЯЗОК ═══════════════════════

async function api(path, options = {}) {
  const opts = Object.assign({ headers: {} }, options);
  opts.headers['Authorization'] = 'Bearer ' + S.token;

  if (opts.body !== undefined && typeof opts.body !== 'string') {
    opts.headers['Content-Type'] = 'application/json';
    opts.body = JSON.stringify(opts.body);
  }

  let response;
  try {
    response = await fetch(path, opts);
  } catch (e) {
    // Мережа зникла — на складі це норма, а не аварія. Кажемо про це
    // словами, а не «Failed to fetch»
    throw new Error('Немає зв\'язку з сервером. Перевірте мережу й спробуйте ще раз.');
  }

  if (response.status === 401) {
    logout(true);
    throw new Error('Сеанс завершився.');
  }

  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || 'Помилка сервера.');

  return data;
}

// ═══════════════════════ ВХІД ═══════════════════════

function renderLogin(message) {
  $('hdr').classList.add('hidden');
  $('app').innerHTML = `
    <div style="padding:34px 4px 20px;text-align:center">
      <div style="font-size:40px">📦</div>
      <div style="font-size:22px;font-weight:800;margin-top:6px">Облік · Сканер</div>
      <div class="muted" style="margin-top:4px">Складський термінал</div>
    </div>
    ${message ? `<div class="msg err">${esc(message)}</div>` : ''}
    <label>ЛОГІН</label>
    <input id="lg" autocomplete="username" autocapitalize="none" autocorrect="off">
    <label>ПАРОЛЬ СКАНЕРА</label>
    <input id="pw" type="password" autocomplete="current-password">
    <div class="muted" style="margin:-2px 2px 14px">
      Це окремий пароль, не той, яким ви заходите в програму на комп'ютері.
    </div>
    <button class="btn primary" id="btnLogin">Увійти</button>`;

  $('btnLogin').onclick = doLogin;
  $('pw').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
}

async function doLogin() {
  const btn = $('btnLogin');
  btn.disabled = true;
  btn.textContent = 'Заходжу…';

  try {
    const response = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: $('lg').value, password: $('pw').value })
    });

    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Не вдалося увійти.');

    S.token = data.token;
    S.user = data.user;
    localStorage.setItem('oblik_token', S.token);

    go('home');
  } catch (e) {
    renderLogin(e.message);
  }
}

function logout(silent) {
  if (!silent) api('/api/logout', { method: 'POST' }).catch(() => {});
  S.token = '';
  S.user = null;
  localStorage.removeItem('oblik_token');
  renderLogin();
}

// ═══════════════════════ НАВІГАЦІЯ ═══════════════════════

function go(view, arg, push = true) {
  if (push && S.view) S.stack.push({ view: S.view, arg: S.arg });
  S.view = view;
  S.arg = arg;
  render();
}

function goBack() {
  const previous = S.stack.pop();
  if (previous) { S.view = previous.view; S.arg = previous.arg; render(); }
  else go('home', null, false);
}

function chrome(title, showBack) {
  $('hdr').classList.remove('hidden');
  $('title').textContent = title;
  $('btnBack').classList.toggle('hidden', !showBack);
  $('who').innerHTML = S.user
    ? esc(S.user.name) + '<br>' + esc(S.user.org || S.user.role)
    : '';
}

function render() {
  const map = { home: viewHome, item: viewItem, session: viewSession, newdoc: viewNewDoc, search: viewSearch };
  (map[S.view] || viewHome)();
}

// ═══════════════════════ ГОЛОВНА ═══════════════════════

async function viewHome() {
  chrome('Облік · Сканер', false);
  S.stack = [];

  $('app').innerHTML = `
    <button class="btn scan" onclick="scanLookup()">📷 Сканувати</button>
    <label>ПОШУК ЗА НАЗВОЮ АБО НОМЕРОМ</label>
    <input id="q" placeholder="Наприклад: бомбер або S/N" enterkeyhint="search">
    <button class="btn ghost" onclick="go('search', $('q').value)">Знайти</button>
    <div style="height:14px"></div>
    <div id="docs"><div class="muted">Завантажую…</div></div>`;

  $('q').addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); go('search', e.target.value); }
  });

  if (!S.user || S.user.canScan !== false) {
    try {
      const sessions = await api('/api/sessions');

      $('docs').innerHTML =
        `<label>ДОКУМЕНТИ</label>` +
        (sessions.length
          ? sessions.map(s => `
              <button class="tile" onclick="openSession(${s.id})">
                <b>${esc(s.kindText)}${s.warehouseName ? ' · ' + esc(s.warehouseName) : ''}</b>
                <span class="sub">${s.itemCount} поз. · відкрито ${esc(s.createdAt)}</span>
              </button>`).join('')
          : '<div class="muted" style="margin-bottom:10px">Незавершених документів немає.</div>') +
        `<button class="btn blue" onclick="go('newdoc')">+ Новий документ</button>
         <button class="btn ghost" onclick="logout()">Вийти</button>`;
    } catch (e) {
      $('docs').innerHTML = `<div class="msg err">${esc(e.message)}</div>`;
    }
  }
}

// ═══════════════════════ ПОШУК ═══════════════════════

async function viewSearch() {
  chrome('Пошук', true);
  $('app').innerHTML = '<div class="muted">Шукаю…</div>';

  try {
    const found = await api('/api/search?q=' + encodeURIComponent(S.arg || ''));

    $('app').innerHTML = found.length
      ? found.map(cardTile).join('')
      : '<div class="card"><div class="muted">Нічого не знайшлось. Спробуйте частину назви або серійний номер.</div></div>';
  } catch (e) {
    $('app').innerHTML = `<div class="msg err">${esc(e.message)}</div>`;
  }
}

function cardTile(c) {
  return `<button class="tile" onclick="go('item', ${c.id})">
    <b>${esc(c.name)}</b>
    <span class="sub">${esc(c.warehouse)} · ${num(c.quantity)} ${esc(c.unit)}${
      c.serialNumber ? ' · ' + esc(c.serialNumber) : ''}${
      c.status === 'Списано' ? ' · СПИСАНО' : ''}</span>
  </button>`;
}

// ═══════════════════════ КАРТКА ПАРТІЇ ═══════════════════════

async function viewItem() {
  chrome('Картка майна', true);
  $('app').innerHTML = '<div class="muted">Завантажую…</div>';

  try {
    const c = await api('/api/item/' + S.arg);

    const condition = c.condition && c.condition !== 'Справний'
      ? `<span class="pill bad">${esc(c.condition)}</span>`
      : `<span class="pill ok">${esc(c.condition || 'Справний')}</span>`;

    const status = c.status === 'Списано'
      ? '<span class="pill bad">Списано</span>'
      : `<span class="pill ok">${esc(c.status)}</span>`;

    $('app').innerHTML = `
      <div class="card">
        <h2>${esc(c.name)}</h2>
        <div class="muted" style="margin-bottom:10px">${esc(c.category)}</div>
        <div style="font-size:32px;font-weight:800;color:#38BDF8">${num(c.quantity)} <span style="font-size:16px;color:#64748B">${esc(c.unit)}</span></div>
        <div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap">${status}${condition}</div>
      </div>
      <div class="card">
        ${row('Склад', c.warehouse)}
        ${c.organization ? row('Фірма', c.organization) : ''}
        ${c.serialNumber ? row('Серійний номер', c.serialNumber) : ''}
        ${c.supplier ? row('Постачальник', c.supplier) : ''}
        ${c.arrivalDate ? row('Надійшло', c.arrivalDate) : ''}
        ${c.responsible ? row('Відповідальний', c.responsible) : ''}
        ${row('На балансі', c.onBalance ? 'Так' : 'Ні')}
        ${c.lastMove ? row('Останній рух', c.lastMove) : ''}
        ${c.comment ? row('Примітка', c.comment) : ''}
      </div>
      <div id="addBox"></div>`;

    // Якщо зараз набирається документ — пропонуємо покласти позицію туди.
    // Це головний шлях: людина відсканувала, побачила, що це те саме, і
    // одним рухом додала
    if (S.session && S.session.status === 'Набирається') {
      $('addBox').innerHTML = `
        <button class="btn primary" onclick="addToOpen(${c.id})">
          + Додати в «${esc(S.session.kindText)}»
        </button>`;
    }
  } catch (e) {
    $('app').innerHTML = `<div class="msg err">${esc(e.message)}</div>
      <button class="btn ghost" onclick="go('home')">На головну</button>`;
  }
}

const row = (k, v) => `<div class="row"><span class="k">${esc(k)}</span><span class="v">${esc(v)}</span></div>`;

async function addToOpen(stockId) {
  try {
    const r = await api(`/api/sessions/${S.session.id}/items`, {
      method: 'POST', body: { stockId, quantity: 1 }
    });
    toast(r.message, true);
    openSession(S.session.id);
  } catch (e) {
    toast(e.message, false);
  }
}

// ═══════════════════════ НОВИЙ ДОКУМЕНТ ═══════════════════════

async function viewNewDoc() {
  chrome('Новий документ', true);
  $('app').innerHTML = '<div class="muted">Завантажую склади…</div>';

  try {
    if (!S.warehouses.length) S.warehouses = await api('/api/warehouses');

    const options = S.warehouses.map(w =>
      `<option value="${w.id}"${w.id === S.user?.warehouseId ? ' selected' : ''}>${
        esc(w.orgName ? w.orgName + ' · ' + w.name : w.name)}</option>`).join('');

    $('app').innerHTML = `
      <label>ЩО РОБИМО</label>
      <select id="kind" onchange="toggleTarget()">
        <option value="invoice">Накладна — перемістити на інший склад</option>
        <option value="inventory">Інвентаризація — обійти й порахувати</option>
        <option value="writeoff">Списання — подати заявку</option>
      </select>

      <label>СКЛАД, З ЯКОГО ПРАЦЮЄТЕ</label>
      <select id="wh">${options}</select>

      <div id="targetBox">
        <label>КУДИ ЇДЕ</label>
        <select id="twh">${options}</select>
      </div>

      <label>ПРИМІТКА (НЕОБОВ'ЯЗКОВО)</label>
      <input id="note" placeholder="Наприклад: за заявкою від 12.03">

      <div class="card" id="hint"></div>
      <button class="btn primary" id="btnCreate">Почати</button>`;

    $('btnCreate').onclick = createDoc;
    toggleTarget();
  } catch (e) {
    $('app').innerHTML = `<div class="msg err">${esc(e.message)}</div>`;
  }
}

function toggleTarget() {
  const kind = $('kind').value;
  $('targetBox').classList.toggle('hidden', kind !== 'invoice');

  // Кажемо наперед, чим це закінчиться. Людина має розуміти, що телефон
  // готує документ, а не проводить операцію остаточно
  $('hint').innerHTML = {
    invoice: '<div class="muted">Наприкінці створиться накладна зі статусом «Надіслано». Кладовщик приймаючого складу підтвердить її у програмі — тоді майно й переїде.</div>',
    inventory: '<div class="muted">Скануєте те, що фізично знайшли. Усе, що числиться на складі й не потрапило під камеру, ляже в акт як нестача. Розбіжності застосовує головний кладовщик.</div>',
    writeoff: '<div class="muted">Створиться заявка на списання зі статусом «Очікує». Рішення ухвалює головний кладовщик — сканер нічого не списує сам.</div>'
  }[kind];
}

async function createDoc() {
  const btn = $('btnCreate');
  btn.disabled = true;

  try {
    const body = {
      kind: $('kind').value,
      warehouseId: parseInt($('wh').value, 10),
      note: $('note').value
    };

    if (body.kind === 'invoice') body.targetWarehouseId = parseInt($('twh').value, 10);

    const r = await api('/api/sessions', { method: 'POST', body });
    openSession(r.id);
  } catch (e) {
    btn.disabled = false;
    toast(e.message, false);
  }
}

// ═══════════════════════ ДОКУМЕНТ ═══════════════════════

async function openSession(id) {
  const list = await api('/api/sessions').catch(() => []);
  S.session = list.find(s => s.id === id) || null;
  go('session', id, S.view !== 'session');
}

async function viewSession() {
  const s = S.session;
  if (!s) { go('home'); return; }

  chrome(s.kindText, true);
  $('app').innerHTML = '<div class="muted">Завантажую…</div>';

  try {
    S.items = await api(`/api/sessions/${s.id}/items`);

    const where = s.kind === 'invoice'
      ? `${esc(s.warehouseName)} → ${esc(s.targetWarehouseName)}`
      : esc(s.warehouseName);

    $('app').innerHTML = `
      <div class="card">
        <div class="row"><span class="k">Напрямок</span><span class="v">${where}</span></div>
        <div class="row"><span class="k">Позицій</span><span class="v">${S.items.length}</span></div>
        ${s.note ? row('Примітка', s.note) : ''}
      </div>

      <button class="btn scan" onclick="scanInto(${s.id})">📷 Сканувати в документ</button>
      <button class="btn ghost" onclick="go('search','')">Знайти вручну</button>

      <label style="margin-top:14px">ВІДСКАНОВАНО</label>
      <div id="list">${
        S.items.length
          ? S.items.map(i => `
              <div class="item">
                <div>
                  <div class="n">${esc(i.productName)}</div>
                  <div class="s">${esc(i.serialNumber || '—')} · ${num(i.quantity)} ${esc(i.unit)}</div>
                </div>
                <button class="x" onclick="removeItem(${i.id})">✕</button>
              </div>`).join('')
          : '<div class="muted" style="margin-bottom:12px">Поки порожньо.</div>'}
      </div>

      <label style="margin-top:6px">КОМЕНТАР ДО ДОКУМЕНТА</label>
      <input id="comment" placeholder="${s.kind === 'writeoff' ? 'Причина списання — обовʼязково' : 'Необовʼязково'}">

      <button class="btn primary" id="btnCommit" ${S.items.length ? '' : 'disabled'}>Провести</button>
      <button class="btn danger" onclick="cancelSession(${s.id})">Скасувати документ</button>`;

    $('btnCommit').onclick = commitSession;
  } catch (e) {
    $('app').innerHTML = `<div class="msg err">${esc(e.message)}</div>`;
  }
}

async function removeItem(itemId) {
  try {
    await api(`/api/sessions/${S.session.id}/items/${itemId}`, { method: 'DELETE' });
    viewSession();
  } catch (e) { toast(e.message, false); }
}

async function commitSession() {
  const comment = $('comment').value.trim();

  if (S.session.kind === 'writeoff' && comment.length < 5) {
    toast('Впишіть причину списання — без неї заявку не приймуть.', false);
    return;
  }

  if (!confirm(`Провести «${S.session.kindText}» на ${S.items.length} позицій?`)) return;

  const btn = $('btnCommit');
  btn.disabled = true;
  btn.textContent = 'Проводжу…';

  try {
    const r = await api(`/api/sessions/${S.session.id}/commit`, { method: 'POST', body: { comment } });
    S.session = null;
    chrome('Готово', false);
    $('app').innerHTML = `<div class="msg ok">${esc(r.message)}</div>
      <button class="btn primary" onclick="go('home')">На головну</button>`;
  } catch (e) {
    btn.disabled = false;
    btn.textContent = 'Провести';
    toast(e.message, false);
  }
}

async function cancelSession(id) {
  if (!confirm('Скасувати документ? Усе відскановане в ньому пропаде.')) return;

  try {
    await api(`/api/sessions/${id}/cancel`, { method: 'POST' });
    S.session = null;
    go('home', null, false);
  } catch (e) { toast(e.message, false); }
}

// ═══════════════════════ СКАНУВАННЯ ═══════════════════════

let stream = null, scanning = false, lastCode = '', lastAt = 0;

function scanLookup() { startScan(null); }
function scanInto(sessionId) { S.scanned = 0; startScan(sessionId); }

async function startScan(sessionId) {
  S.scanTarget = sessionId;

  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    toast('Браузер не дає доступ до камери. Перевірте, що адреса відкрита через https.', false);
    return;
  }

  $('scanner').classList.remove('hidden');
  $('scanInfo').textContent = 'Наведіть на QR-етикетку';
  $('scanCount').textContent = sessionId ? 'Додано: 0' : '';

  try {
    stream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 } }
    });
  } catch (e) {
    stopScan();
    toast('Камера недоступна. Дозвольте доступ до камери в налаштуваннях браузера.', false);
    return;
  }

  const video = $('video');
  video.srcObject = stream;
  await video.play();

  scanning = true;
  requestAnimationFrame(tick);
}

const canvas = document.createElement('canvas');
const ctx = canvas.getContext('2d', { willReadFrequently: true });

function tick() {
  if (!scanning) return;

  const video = $('video');

  if (video.readyState === video.HAVE_ENOUGH_DATA) {
    // Зменшуємо кадр перед розбором: на повній роздільності телефон
    // з'їдає батарею й гріється, а QR розпізнається однаково
    const scale = Math.min(1, 640 / video.videoWidth);
    canvas.width = video.videoWidth * scale;
    canvas.height = video.videoHeight * scale;

    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

    const image = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const found = jsQR(image.data, image.width, image.height, { inversionAttempts: 'dontInvert' });

    if (found && found.data) handleCode(found.data);
  }

  requestAnimationFrame(tick);
}

function handleCode(code) {
  const now = Date.now();

  // Камера ловить той самий код десятки разів на секунду. Без цієї
  // затримки одне піднесення етикетки давало б сотню запитів
  if (code === lastCode && now - lastAt < 2500) return;

  lastCode = code;
  lastAt = now;

  if (navigator.vibrate) navigator.vibrate(60);

  if (S.scanTarget) addScanned(code);
  else {
    stopScan();
    lookup(code);
  }
}

async function addScanned(code) {
  $('scanInfo').textContent = 'Додаю…';

  try {
    const r = await api(`/api/sessions/${S.scanTarget}/items`, {
      method: 'POST', body: { code, quantity: 1 }
    });

    S.scanned++;
    $('scanInfo').innerHTML = '<span style="color:#22C55E">✓ ' + esc(r.message) + '</span>';
    $('scanCount').textContent = 'Додано: ' + S.scanned;
  } catch (e) {
    // Помилку показуємо прямо в сканері й НЕ закриваємо його: людина
    // стоїть біля стелажа, і виганяти її на іншу сторінку заради
    // «вже є в наборі» означає ламати весь ритм обходу
    $('scanInfo').innerHTML = '<span style="color:#F87171">✕ ' + esc(e.message) + '</span>';
    if (navigator.vibrate) navigator.vibrate([80, 60, 80]);
  }
}

async function lookup(code) {
  chrome('Пошук', true);
  $('app').innerHTML = '<div class="muted">Шукаю…</div>';

  try {
    const found = await api('/api/lookup?code=' + encodeURIComponent(code));

    if (found.length === 1) { go('item', found[0].id); return; }

    S.view = 'search';
    $('app').innerHTML = found.length
      ? found.map(cardTile).join('')
      : `<div class="card"><div class="muted">Код прочитано, але такої позиції в базі немає.</div>
         <div class="muted" style="margin-top:8px;font-family:ui-monospace,monospace;word-break:break-all">${esc(code)}</div></div>
         <button class="btn ghost" onclick="go('home')">На головну</button>`;
  } catch (e) {
    $('app').innerHTML = `<div class="msg err">${esc(e.message)}</div>
      <button class="btn ghost" onclick="go('home')">На головну</button>`;
  }
}

function stopScan() {
  scanning = false;
  lastCode = '';

  if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }

  $('video').srcObject = null;
  $('scanner').classList.add('hidden');

  if (S.scanTarget) { const id = S.scanTarget; S.scanTarget = null; openSession(id); }
  S.scanTarget = null;
}

/** Запасний шлях: етикетка затерта або камера не бере. */
function promptManual() {
  const code = prompt('Введіть номер із етикетки (наприклад 1234 або OBLIK-S-1234):');
  if (!code) return;

  const clean = code.trim();
  if (/^\d+$/.test(clean)) handleCode('s_' + clean);
  else handleCode(clean);
}

// ═══════════════════════ ДРІБНИЦІ ═══════════════════════

function toast(text, ok) {
  const box = document.createElement('div');
  box.className = 'msg ' + (ok ? 'ok' : 'err');
  box.textContent = text;
  box.style.cssText += 'position:fixed;left:12px;right:12px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:200;box-shadow:0 10px 30px rgba(0,0,0,.6)';
  document.body.appendChild(box);
  setTimeout(() => box.remove(), 4000);
}

// ═══════════════════════ СТАРТ ═══════════════════════

(async function start() {
  if (!S.token) { renderLogin(); return; }

  try {
    S.user = await api('/api/me');
  } catch {
    return; // api() сам показав вхід
  }

  // Прийшли з QR-етикетки: /i/1234
  const match = location.pathname.match(/^\/i\/(\d+)/);

  if (match) {
    history.replaceState(null, '', '/');
    go('item', parseInt(match[1], 10), false);
  } else {
    go('home', null, false);
  }
})();
</script>
</body>
</html>
